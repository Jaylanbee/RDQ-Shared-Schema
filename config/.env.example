# RDQ/EDS 生態系共用資料庫路徑設定
# 若未設定此環境變數，系統預設使用 ~/.education_ecosystem/review_index.db
#
# 使用方式（PowerShell）：
#   $env:ECOSYSTEM_DB_PATH = "D:\SharedData\review_index.db"
#   python rdq_store.py '<json>'
#
# 使用方式（CMD）：
#   set ECOSYSTEM_DB_PATH=D:\SharedData\review_index.db
#   python rdq_store.py '<json>'
#
# 使用方式（Linux/macOS）：
#   export ECOSYSTEM_DB_PATH=/mnt/shared/review_index.db
#   python3 rdq_store.py '<json>'

ECOSYSTEM_DB_PATH=
